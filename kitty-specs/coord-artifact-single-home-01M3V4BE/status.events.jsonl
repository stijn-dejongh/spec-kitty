{"aggregate_id": "01M3V4BEWYPR3TP9N6A95A44KN", "aggregate_type": "Mission", "event_id": "01M3V4BEYQV0SCEZ4W1N5E24NS", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-10-01T07:02:40.338715+00:00", "friendly_name": "Coordination artifacts get one durable home", "mission_id": "01M3V4BEWYPR3TP9N6A95A44KN", "mission_number": null, "mission_slug": "coord-artifact-single-home-01M3V4BE", "mission_type": "software-dev", "purpose_context": "Coordination-topology missions currently write their lifecycle records to the primary checkout until the coordination worktree is populated, then switch surfaces without carrying the earlier records over. Operators see status committed to their target branch, commits reported as unchanged while work is uncommitted, decision logs forked in two, and a doctor repair that drops decisions while verify reports clean. This mission gives those records a single durable home for the mission's whole lifetime and makes every command report honestly where they went.", "purpose_tldr": "Make every coordination-routed mission keep its status, decision and trace records in one place from the moment it is created, so the CLI never commits them to the wrong branch, silently skips them, or loses them during repair.", "target_branch": "issue-5440-coord-artifact-single-home", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-01T07:02:40.343219+00:00"}

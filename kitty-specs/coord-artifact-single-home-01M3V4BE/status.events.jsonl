{"at": "2026-10-01T07:06:41.656279+00:00", "event_id": "01M3V4JTKRZTXEWW83D70SKP8H", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M3V4BXG1EP7JX83TM5K6WSJ8", "final_answer": "Classify as PRIMARY: DECISION_LEDGER (DM-*.md + index.json) moves to the PRIMARY partition, matching where it is read and written today; decision events stay in the COORD status log; doctor joins the two through the seam; ADR amendment records the reversal of the #3928 intent.", "mission_id": "01M3V4BEWYPR3TP9N6A95A44KN", "mission_slug": "coord-artifact-single-home-01M3V4BE", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-10-01T07:06:41.656279Z", "resolved_by": "cli", "run_id": "01M3V4BXG1EP7JX83TM5K6WSJ8", "state_entered_at": "2026-10-01T07:06:41.648010Z", "summary": null, "terminal_outcome": "resolved"}}

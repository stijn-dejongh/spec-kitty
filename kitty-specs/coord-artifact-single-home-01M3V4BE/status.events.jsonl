{"at": "2026-10-01T07:20:18.537480+00:00", "event_id": "01M3V5BRB98FGZMSXY12E3HHV0", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M3V5BPDBB9WG0KYY9Q4FVY58", "final_answer": "Fix-forward via doctor only: no read fallback. doctor decisions detects a ledger present only on the coordination branch and --repair copies it to the PRIMARY partition; teardown must not destroy such ledger content before it is repaired.", "mission_id": "01M3V4BEWYPR3TP9N6A95A44KN", "mission_slug": "coord-artifact-single-home-01M3V4BE", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-10-01T07:20:18.537480Z", "resolved_by": "cli", "run_id": "01M3V5BPDBB9WG0KYY9Q4FVY58", "state_entered_at": "2026-10-01T07:20:18.529871Z", "summary": null, "terminal_outcome": "resolved"}}

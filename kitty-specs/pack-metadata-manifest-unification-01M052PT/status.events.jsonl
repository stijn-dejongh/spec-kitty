{"aggregate_id": "01M052PTYBFFWZXNP1V7A7G753", "aggregate_type": "Mission", "event_id": "01M052PVQTQDKQYH3PSVYHT391", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-16T10:43:32.939654+00:00", "friendly_name": "Pack-Metadata Manifest Unification", "mission_id": "01M052PTYBFFWZXNP1V7A7G753", "mission_number": null, "mission_slug": "pack-metadata-manifest-unification-01M052PT", "mission_type": "software-dev", "purpose_context": "Doctrine, org, fetched, and charter packs describe what they contain in two incompatible manifests today (counts vs enumerated), and the built-in reference pack every other pack extends has none \u2014 so pack contents and parent/lineage cannot be verified or navigated consistently. This mission unifies pack metadata onto a single canonical manifest per ADR 2026-08-16-1, making packs trustworthy, navigable units and providing the substrate for verified distribution (epic #2539).", "purpose_tldr": "Give every pack one verifiable manifest of its constituent parts and lineage, replacing two divergent formats.", "target_branch": "feat/pack-metadata-manifest-unification", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-16T10:43:33.754752+00:00"}
